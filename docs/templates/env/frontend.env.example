# <PROJECT> — frontend environment
#
# Copy to .env.local and fill in. NEVER commit .env.local.
# When you add a variable here, add it in the SAME PR as the code that needs it.
#
#   cp .env.example .env.local

# ---------------------------------------------------------------------------
# PUBLIC — compiled into the browser bundle. Anyone can read these.
# Never put a secret behind a NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# Base URL of the API, including the version prefix.
# local:      http://localhost:4000/api/v1
# staging:    https://<project>-api-staging.up.railway.app/api/v1
# production: https://<project>-api.up.railway.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Build screens against mock data before the endpoint exists.
# MUST be false on staging and production. See 06_FRONTEND_GUIDE.md.
NEXT_PUBLIC_USE_MOCKS=false

# ---------------------------------------------------------------------------
# SERVER-ONLY — never prefixed with NEXT_PUBLIC_
# ---------------------------------------------------------------------------

# Auth.js v5 session secret. Generate with: openssl rand -base64 32
# Must be IDENTICAL to the backend's AUTH_SECRET, and different per environment.
AUTH_SECRET=

# Google OAuth credentials (Google Cloud Console -> Credentials).
# Authorised redirect URI: <app-url>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The app's own URL. Must match the environment exactly.
NEXTAUTH_URL=http://localhost:3000
