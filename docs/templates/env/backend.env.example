# <PROJECT> — backend environment
#
# Copy to .env and fill in. NEVER commit .env.
# When you add a variable here, add it in the SAME PR as the code that needs it.
# Every variable below is validated at startup by src/config/env.ts, so a
# missing one fails immediately and tells you its name.
#
#   cp .env.example .env

# development | staging | production
NODE_ENV=development

PORT=4000

# ---------------------------------------------------------------------------
# SECRET — this string contains your database password.
# Never commit it. Never paste it in group chat. Rotate it if it leaks.
# ---------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Use the SHARED hosted dev database — not your own local one.
# See 07_BACKEND_GUIDE.md and 09_ENVIRONMENTS_SECRETS_DEVOPS.md.
DATABASE_URL=

# Where the frontend is served from — the browser origin allowed by CORS.
# local:      http://localhost:3000
# production: https://<project>.vercel.app
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# SECRET — must be IDENTICAL to the frontend's AUTH_SECRET.
# Generate with: openssl rand -base64 32   (min 32 characters)
# ---------------------------------------------------------------------------
AUTH_SECRET=
